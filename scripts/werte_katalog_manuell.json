  "osmose": [
    { "feld": "permeat_lh_api",    "label": "Permeat",                "einheit": "l/h", "art": "ergebnis", "api": "GemaOsmose.getResults(objektId).permeat_lh" },
    { "feld": "permeat_ls_api",    "label": "Permeat",                "einheit": "l/s", "art": "ergebnis", "api": "GemaOsmose.getResults(objektId).permeat_ls" },
    { "feld": "konzentrat_lh_api", "label": "Konzentrat",             "einheit": "l/h", "art": "ergebnis", "api": "GemaOsmose.getResults(objektId).konzentrat_lh" },
    { "feld": "konzentrat_ls_api", "label": "Konzentrat",             "einheit": "l/s", "art": "ergebnis", "api": "GemaOsmose.getResults(objektId).konzentrat_ls" },
    { "feld": "weichwasser_lh_api","label": "Weichwasserbedarf",      "einheit": "l/h", "art": "ergebnis", "api": "GemaOsmose.getResults(objektId).weichwasser_lh" },
