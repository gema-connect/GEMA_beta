    { "feld": "q_ww_api",   "label": "Spitzenvolumenstrom Warmwasser (WW)",        "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'ww')" },
    { "feld": "q_nd_api",   "label": "Spitzenvolumenstrom Netzdruck (ND)",         "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'nd')" },
    { "feld": "q_bw_api",   "label": "Spitzenvolumenstrom Enthärtetes Wasser (BW)", "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'bw')" },
    { "feld": "q_ow_api",   "label": "Spitzenvolumenstrom Osmose (OW)",            "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'ow')" },
    { "feld": "q_gw_api",   "label": "Spitzenvolumenstrom Regenwasser (RW)",       "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'gw')" },
    { "feld": "q_grau_api", "label": "Spitzenvolumenstrom Grauwasser (GW)",        "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getSpitzenvolumenstrom(objektId,'grau')" },
    { "feld": "q_ha_api",   "label": "Belastung Hausanschlussleitung (Gesamt-LU)", "einheit": "l/s", "art": "ergebnis", "api": "GemaLU.getHausanschluss(objektId)" },
    { "feld": "verbraucher_api", "label": "Verbraucher-Liste (alle Medien)",       "einheit": "",    "art": "ergebnis", "api": "GemaLU.getVerbraucher(objektId)" },
    { "feld": "summary_api",     "label": "Zusammenfassung aller Medien",          "einheit": "",    "art": "ergebnis", "api": "GemaLU.getSummary(objektId)" }
